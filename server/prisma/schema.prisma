// ═══════════════════════════════════════════════════════════════════════
// VAICS ITSM — Prisma Schema (PostgreSQL)
// Reference source: Combodo iTop XML Data Models (ITOP_REFERENCE.md)
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  CHANGE
  PROBLEM
}

enum UserRole {
  ADMIN
  AGENT
  MANAGER
  CHANGE_MANAGER
  USER
  READ_ONLY
}

enum TicketOrigin {
  IN_PERSON
  CHAT
  MAIL
  PHONE
  PORTAL
  MONITORING
}

enum ResolutionCode {
  ASSISTANCE
  OTHER
  SOFTWARE_PATCH
  TRAINING
  HARDWARE_REPAIR
  SYSTEM_UPDATE
  BUG_FIXED
}

enum Satisfaction {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_UPDATED
  APPROVAL_REQUESTED
  APPROVAL_RESPONDED
  COMMENT_ADDED
  SLA_WARNING
  SLA_BREACH
}

// ═══════════════════════════════════════════════════════════
// CORE — ORGANIZATION
// ═══════════════════════════════════════════════════════════

model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  status    String   @default("production")
  parentId  Int?
  parent    Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children  Organization[] @relation("OrgHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  teams         Team[]
  tickets       Ticket[]
  services      Service[]
  slas          SLA[]
  contracts     CustomerContract[]
  webhooks      Webhook[]
  configurationItems CI[]

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════
// CORE — USER, TEAM
// ═══════════════════════════════════════════════════════════

model User {
  id              Int      @id @default(autoincrement())
  login           String   @unique
  email           String   @unique
  password        String
  role            UserRole @default(USER)
  status          String   @default("ENABLED")
  profile         Json     @default("{}")
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  managerId       Int?
  manager         User?        @relation("UserManager", fields: [managerId], references: [id])
  subordinates    User[]       @relation("UserManager")
  lastLogin       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teamMemberships      TeamMember[]
  assignedTickets      Ticket[]      @relation("AssignedTickets")
  createdTickets       Ticket[]      @relation("CreatedTickets")
  workOrderAssignments WorkOrder[]   @relation("WorkOrderAgent")
  approvalEntries      Approval[]    @relation("ApprovalApprover")
  ticketContactEntries TicketContact[] @relation("TicketContactUser")
  comments             Comment[]
  historyEntries       AuditTrail[]
  notifications        Notification[]

  @@map("users")
}

model Team {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  type            String   @default("SUPPORT")
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members        TeamMember[]
  assignedTickets Ticket[]

  @@unique([name, organizationId])
  @@map("teams")
}

model TeamMember {
  id      Int @id @default(autoincrement())
  userId  Int
  user    User @relation(fields: [userId], references: [id])
  teamId  Int
  team    Team @relation(fields: [teamId], references: [id])
  role    String?

  @@unique([userId, teamId])
  @@map("team_members")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — TICKET (Single table, type-discriminated)
// ═══════════════════════════════════════════════════════════

model Ticket {
  id              Int         @id @default(autoincrement())
  ref             String      @unique
  type            TicketType
  status          String      @default("new")

  // ── Core fields ──
  title           String
  description     String      @default("")
  priority        Int         @default(4)
  impact          Int?
  urgency         Int?
  origin          TicketOrigin?

  // ── Relationships ──
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdById     Int?
  createdBy       User?        @relation("CreatedTickets", fields: [createdById], references: [id])
  assignedToId    Int?
  assignedTo      User?        @relation("AssignedTickets", fields: [assignedToId], references: [id])
  teamId          Int?
  team            Team?        @relation(fields: [teamId], references: [id])

  // ── Service / SLA ──
  serviceId             Int?
  service               Service?         @relation(fields: [serviceId], references: [id])
  serviceSubcategoryId  Int?
  serviceSubcategory    ServiceSubcategory? @relation(fields: [serviceSubcategoryId], references: [id])
  ttoDeadline           DateTime?
  ttrDeadline           DateTime?
  ttoPassed             Boolean?
  ttrPassed             Boolean?
  ttoOverrun            Int?
  ttrOverrun            Int?
  ttoTimeSpent          Int?
  ttrTimeSpent          Int?

  // ── Dates ──
  assignmentDate  DateTime?
  resolutionDate  DateTime?
  resolvedAt      DateTime?
  closeDate       DateTime?
  lastPendingDate DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // ── Resolution ──
  resolutionCode  ResolutionCode?
  solution        String?
  pendingReason   String?
  timeSpent       Int?

  // ── Ticket-type specific ──
  requestType      String?
  escalationFlag   Boolean  @default(false)
  escalationReason String?
  reason           String?
  changeCategory   String?
  outage           String?
  fallbackPlan     String?
  acceptanceDate   DateTime?
  approvalDate     DateTime?
  approvalComment  String?
  product          String?

  // ── User satisfaction ──
  userSatisfaction Satisfaction?
  userComment      String?

  // ── Parent/Child hierarchy ──
  parentTicketId  Int?
  parentTicket    Ticket?       @relation("TicketHierarchy", fields: [parentTicketId], references: [id])
  childTickets    Ticket[]      @relation("TicketHierarchy")

  comments        Comment[]
  historyEntries  AuditTrail[]
  workOrders      WorkOrder[]
  ciRelationships CIRelatedTicket[]
  linkedContacts  TicketContact[]
  notifications   Notification[]
  approvals       Approval[]

  @@index([type, status])
  @@index([organizationId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([teamId])
  @@index([ref])
  @@map("tickets")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — COMMENTS
// ═══════════════════════════════════════════════════════════

model Comment {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  text        String
  type        String    @default("public")
  createdAt   DateTime  @default(now())

  @@index([ticketId])
  @@map("comments")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — AUDIT TRAIL
// ═══════════════════════════════════════════════════════════

model AuditTrail {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("audit_trail")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — WORK ORDER
// ═══════════════════════════════════════════════════════════

model WorkOrder {
  id          Int        @id @default(autoincrement())
  summary     String
  description String     @default("")
  status      String     @default("open")
  ticketId    Int?
  ticket      Ticket?    @relation(fields: [ticketId], references: [id])
  agentId     Int?
  agent       User?      @relation("WorkOrderAgent", fields: [agentId], references: [id])
  teamId      Int?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ticketId])
  @@map("work_orders")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — APPROVAL
// ═══════════════════════════════════════════════════════════

model Approval {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  approverId  Int
  approver    User      @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      String    @default("pending")
  comment     String?
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([ticketId, approverId])
  @@map("approvals")
}

// ═══════════════════════════════════════════════════════════
// TICKETING — LINK TABLES
// ═══════════════════════════════════════════════════════════

model TicketContact {
  id        Int    @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  contactId Int
  contact   User   @relation("TicketContactUser", fields: [contactId], references: [id])
  role      String?

  @@unique([ticketId, contactId])
  @@map("ticket_contacts")
}

// ═══════════════════════════════════════════════════════════
// SERVICE MANAGEMENT
// ═══════════════════════════════════════════════════════════

model Service {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  status          String    @default("active")
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subcategories    ServiceSubcategory[]
  contractLinks    ContractToService[]
  tickets          Ticket[]
  ciLinks          CIRelatedService[]

  @@unique([name, organizationId])
  @@map("services")
}

model ServiceSubcategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("active")
  serviceId   Int
  service     Service   @relation(fields: [serviceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tickets     Ticket[]

  @@unique([name, serviceId])
  @@map("service_subcategories")
}

// ═══════════════════════════════════════════════════════════
// SLA MANAGEMENT
// ═══════════════════════════════════════════════════════════

model SLA {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  workingDays     Int[]     @default([1,2,3,4,5])
  startHour       Int       @default(9)
  endHour         Int       @default(18)
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  targets         SLATarget[]
  contractLinks   ContractToService[]

  @@unique([name, organizationId])
  @@map("slas")
}

model SLATarget {
  id        Int    @id @default(autoincrement())
  slaId     Int
  sla       SLA    @relation(fields: [slaId], references: [id])
  priority  Int
  metric    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slaId, metric, priority])
  @@map("sla_targets")
}

// ═══════════════════════════════════════════════════════════
// CONTRACT MANAGEMENT
// ═══════════════════════════════════════════════════════════

model CustomerContract {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceLinks    ContractToService[]

  @@unique([name, organizationId])
  @@map("customer_contracts")
}

model ContractToService {
  id         Int              @id @default(autoincrement())
  contractId Int
  contract   CustomerContract @relation(fields: [contractId], references: [id])
  serviceId  Int
  service    Service          @relation(fields: [serviceId], references: [id])
  slaId      Int?
  sla        SLA?             @relation(fields: [slaId], references: [id])

  @@unique([contractId, serviceId])
  @@map("contract_to_services")
}

// ═══════════════════════════════════════════════════════════
// CMDB — CONFIGURATION MANAGEMENT
// ═══════════════════════════════════════════════════════════

model CI {
  id              Int      @id @default(autoincrement())
  name            String
  ciType          String
  description     String?
  status          String   @default("production")
  attributes      Json?
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inboundRelationships  CIRelationship[] @relation("TargetCI")
  outboundRelationships CIRelationship[] @relation("SourceCI")
  ticketLinks    CIRelatedTicket[]
  serviceLinks   CIRelatedService[]

  @@index([ciType])
  @@index([organizationId])
  @@map("configuration_items")
}

model CIRelationship {
  id               Int                @id @default(autoincrement())
  sourceCIId       Int
  sourceCI         CI                 @relation("SourceCI", fields: [sourceCIId], references: [id], map: "fk_ci_rel_source")
  targetCIId       Int
  targetCI         CI                 @relation("TargetCI", fields: [targetCIId], references: [id], map: "fk_ci_rel_target")
  relationshipType String
  description      String?
  createdAt        DateTime           @default(now())

  @@unique([sourceCIId, targetCIId, relationshipType])
  @@map("ci_relationships")
}

model CIRelatedTicket {
  id        Int    @id @default(autoincrement())
  ciId      Int
  ci        CI     @relation(fields: [ciId], references: [id])
  ticketId  Int
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  impact    String?
  createdAt DateTime @default(now())

  @@unique([ciId, ticketId])
  @@map("ci_related_tickets")
}

model CIRelatedService {
  id        Int     @id @default(autoincrement())
  ciId      Int
  ci        CI      @relation(fields: [ciId], references: [id])
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([ciId, serviceId])
  @@map("ci_related_services")
}

// ═══════════════════════════════════════════════════════════
// SEQUENCES — For ticket ref auto-generation
// ═══════════════════════════════════════════════════════════

model TicketCounter {
  id       String @id
  prefix   String
  sequence Int    @default(0)

  @@map("ticket_counters")
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String?
  ticketId  Int?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id])
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════
// WEBHOOKS
// ═══════════════════════════════════════════════════════════

model Webhook {
  id             Int      @id @default(autoincrement())
  name           String
  url            String
  events         String[]
  secret         String   @default("")
  enabled        Boolean  @default(true)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("webhooks")
}
